rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Users may only create, read, update or delete their own document
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // workouts, templates and exercises subcollections: owner only
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
